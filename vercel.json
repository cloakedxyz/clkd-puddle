{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npm run build:site",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' https://arb1.arbitrum.io; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/docs/contracts/:path*", "destination": "/docs/architecture/", "permanent": true },
    {
      "source": "/docs/fees/:path*",
      "destination": "/docs/architecture/#settlement",
      "permanent": true
    },
    {
      "source": "/docs/privacy-pools-v1/:path*",
      "destination": "/docs/architecture/",
      "permanent": true
    },
    {
      "source": "/docs/privacy-pools/:path*",
      "destination": "/docs/architecture/",
      "permanent": true
    }
  ]
}
