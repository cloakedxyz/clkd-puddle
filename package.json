{
  "name": "puddle",
  "version": "0.0.0",
  "description": "Fund private balances with an ordinary token transfer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloakedxyz/clkd-puddle.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.ts",
    "dev": "node scripts/railgun-app.ts --demo",
    "dev:railgun": "npm run dev",
    "pilot:railgun": "node scripts/railgun-app.ts",
    "build:sdk": "node scripts/build-sdk.ts",
    "build:site": "node scripts/build-site.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/kernel.test.ts test/sdk.test.ts test/relay.test.ts test/sdk-build.test.ts test/repo.test.ts",
    "test:contracts": "forge test",
    "test:ui": "node --test test/railgun-ui.test.ts",
    "test:site": "npm run build:site && node --test test/site.test.ts",
    "test:sdk-package": "node scripts/check-sdk-package.ts",
    "check:repo": "node scripts/check-repo.ts",
    "format": "prettier --write \"**/*.{md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{md,json,yml,yaml}\"",
    "lint": "npm run check:repo && npm run format:check",
    "check": "npm run lint && npm run typecheck && npm run build:sdk && npm run test:contracts && npm test && npm run test:ui && npm run test:site",
    "test:fork": "node --test test/fork.test.ts"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "devDependencies": {
    "@noble/curves": "2.4.0",
    "@openzeppelin/contracts": "4.9.6",
    "@openzeppelin/contracts-upgradeable": "4.9.6",
    "@railgun-community/engine": "9.8.0",
    "@scure/base": "1.2.6",
    "@types/node": "24.19.0",
    "circomlibjs": "0.1.7",
    "esbuild": "0.25.12",
    "ethers": "6.17.0",
    "playwright": "1.63.0",
    "poseidon-lite": "0.3.0",
    "prettier": "3.9.10",
    "solc": "0.8.17",
    "typescript": "7.0.2"
  },
  "overrides": {
    "bn.js@^4": "4.12.3",
    "form-data@^2": "2.5.6",
    "qs@^6": "6.16.0",
    "ws@^8": "8.21.0",
    "ws@^5": "5.2.5",
    "solc": {
      "tmp": "0.2.7"
    },
    "simple-get@^2": "2.8.2"
  },
  "homepage": "https://puddle.link",
  "bugs": {
    "url": "https://github.com/cloakedxyz/clkd-puddle/issues"
  }
}
